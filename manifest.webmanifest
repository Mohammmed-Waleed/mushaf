{
  "name": "Mushaf — Quran reader",
  "short_name": "Mushaf",
  "description": "Indo-Pak Quran reader: large text or 15-line mushaf, sura and para index, bookmarks, daily surah, audio.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#efe7d3",
